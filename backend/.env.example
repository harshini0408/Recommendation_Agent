# Copy to .env. Keep real values private. Quote passwords if necessary.
APP_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=electronics_assistant
DB_USER=electronics_app
DB_PASSWORD=CHANGE_ME
TEST_DB_NAME=electronics_assistant_test
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# live = real API; demo = limited rule parser, visibly labelled in UI
LLM_MODE=live
LLM_TIMEOUT_SECONDS=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
